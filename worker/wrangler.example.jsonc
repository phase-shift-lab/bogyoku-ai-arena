{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bogyoku-shared-learning",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-17",
  "workers_dev": true,
  "triggers": {
    "crons": ["17 3 * * *"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bogyoku-shared-learning",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "LEARNING_EVENT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60,
      },
    },
  ],
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:5173,https://phase-shift-lab.github.io",
    "MIN_AGGREGATE_GAMES": "30",
    "RECEIPT_RETENTION_DAYS": "30",
    "REQUIRE_RATE_LIMITER": "true",
  },
}
