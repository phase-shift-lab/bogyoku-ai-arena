 namespace YaneuraOu {
 
+#if defined(__EMSCRIPTEN__)
+namespace {
+std::mutex wasm_output_mutex;
+std::queue<std::string> wasm_output_queue;
+std::string wasm_output_buffer;
+
+void emit_usi_line(std::string line) {
+    std::lock_guard<std::mutex> lock(wasm_output_mutex);
+    wasm_output_queue.push(std::move(line));
+}
+}
+
+EMSCRIPTEN_KEEPALIVE extern "C" const char* wasm_poll_output() {
+    std::lock_guard<std::mutex> lock(wasm_output_mutex);
+    if (wasm_output_queue.empty())
+        return nullptr;
+
+    wasm_output_buffer = std::move(wasm_output_queue.front());
+    wasm_output_queue.pop();
+    return wasm_output_buffer.c_str();
+}
+#endif
