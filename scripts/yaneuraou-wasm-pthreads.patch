@@ -344,7 +344,15 @@ void YaneuraOuEngine::resize_threads() {
 
 // 置換表の割り当て
 void YaneuraOuEngine::set_tt_size(size_t mb){
+#if defined(__EMSCRIPTEN_PTHREADS__)
+	// The first Threads command must return to the browser event loop before
+	// newly-created pthreads can finish parking in idle_loop(). The table resize
+	// itself is synchronous and does not need a search-thread rendezvous.
+	if (threads.wasm_workers_ready())
+		wait_for_search_finished();
+#else
 	wait_for_search_finished();
+#endif
 	tt.resize(mb, threads);
 }
 
